<mxfile host="app.diagrams.net" agent="thesis-pipeline" version="24.0.0">
  <diagram id="stage1" name="Query and feedback flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="How a user query becomes a study plan, and how feedback changes the next one" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two agents cooperate: one WRITES the candidate plans, the other DECIDES which feedback is worth learning from." style="text;html=1;fontSize=12;fontColor=#5A6572;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- ================= LANE A : runtime ================= -->
        <mxCell id="laneA" value="PER QUERY  —  runs every time the learner asks for a plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA7B4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#5A6572;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="170" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="User query&#10;&#10;goal, level,&#10;hours per week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#7D8B99;fontSize=11;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="70" y="135" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="Retrieval&#10;&#10;embed query, take&#10;top 25 of 1,899" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="260" y="135" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="&lt;b&gt;Plan Generator Agent&lt;/b&gt;&#10;&#10;writes 6 distinct plans&#10;5 courses each, ordered&#10;temperature 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E2;strokeColor=#B06A00;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="460" y="128" width="180" height="94" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="&lt;b&gt;Reward Model&lt;/b&gt;&#10;&#10;scores all 6&#10;learned from feedback&#10;(6 features)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECFA;strokeColor=#3A4A9F;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="690" y="128" width="170" height="94" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="Best-of-N&#10;&#10;pick highest score&#10;(or sample, to keep&#10;propensities usable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#7D8B99;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="910" y="135" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="&lt;b&gt;Study plan shown&lt;/b&gt;&#10;&#10;ordered course list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1130" y="135" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================= LANE B : feedback ================= -->
        <mxCell id="laneB" value="FEEDBACK LOOP  —  what the learner says changes the SCORER, not the generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B06A00;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#B06A00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1320" height="280" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="Learner reacts&#10;&#10;thumbs up / down&#10;+ a reason in words" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#7D8B99;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1130" y="350" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;Feedback Agent&lt;/b&gt;  (LangGraph)&#10;&#10;Is this credible? actionable?&#10;Does it contradict what they&#10;said before?&#10;temperature 0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E2;strokeColor=#B06A00;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="860" y="340" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b3a" value="ACT&#10;interpret → update&#10;learner model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EE;strokeColor=#0D6158;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="480" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b3b" value="CLARIFY&#10;ask one question,&#10;change nothing yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAE5;strokeColor=#A33A22;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1070" y="480" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b3c" value="RECORD&#10;log it, deliberately&#10;no policy change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#7D8B99;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1240" y="480" width="110" height="56" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="Accepted feedback only&#10;&#10;turned into pairwise&#10;comparisons: plan A&#10;preferred over plan B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#7D8B99;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b&gt;Preference learning&lt;/b&gt;&#10;&#10;Bradley–Terry fit&#10;never sees a reward value,&#10;only which plan won" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECFA;strokeColor=#3A4A9F;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="340" y="340" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="Learner model&#10;&#10;max level, max hours,&#10;topics to avoid,&#10;beliefs in prose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E2;strokeColor=#B06A00;fontSize=11;dashed=1" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="170" height="95" as="geometry" />
        </mxCell>

        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B06A00" edge="1" parent="1" source="a6" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B06A00" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572;dashed=1" edge="1" parent="1" source="b2" target="b3a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572;dashed=1" edge="1" parent="1" source="b2" target="b3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5A6572;dashed=1" edge="1" parent="1" source="b2" target="b3c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb6" value="only the ACT branch&#10;reaches the model" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#0D6158;strokeWidth=2;fontSize=10;fontColor=#0D6158" edge="1" parent="1" source="b3a" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#3A4A9F" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B06A00;dashed=1" edge="1" parent="1" source="b3a" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- feedback closes the loop -->
        <mxCell id="eloop" value="retrains the scorer" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#3A4A9F;strokeWidth=3;fontSize=11;fontColor=#3A4A9F;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="b5" target="a4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="435" y="282" /><mxPoint x="660" y="282" /><mxPoint x="660" y="175" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eloop2" value="constrains the next query" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B06A00;strokeWidth=2;dashed=1;fontSize=10;fontColor=#B06A00;verticalAlign=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="b6" target="a1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="58" y="517" /><mxPoint x="58" y="175" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- ================= LANE C : frozen ================= -->
        <mxCell id="laneC" value="FROZEN  —  read by retrieval and by the reward; built once, hashed, replayable without any API call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0D6158;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#0D6158;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Course catalog&#10;1,899 courses&#10;188 skills, 15 families" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="90" y="660" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Prerequisite graph&#10;254 edges&#10;→ 122 study plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="660" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Simulated learners&#10;500 personas&#10;goal, level, hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="570" y="660" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Reward spec&#10;frozen + hashed&#10;before any run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EF;strokeColor=#0D6158;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="810" y="660" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Firewall&lt;/b&gt;&#10;the recommender never reads the&#10;prerequisite graph or the reward spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAE5;strokeColor=#A33A22;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1050" y="655" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- legend -->
        <mxCell id="lg" value="LLM agent — makes a judgement        Learned from data        Frozen artifact        Dashed = decision branch or soft constraint" style="text;html=1;fontSize=11;fontColor=#5A6572;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=1;fillColor=#FDF3E2;strokeColor=#B06A00;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="40" y="812" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="lg2" value="" style="rounded=1;fillColor=#E9ECFA;strokeColor=#3A4A9F;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="250" y="812" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="lg3" value="" style="rounded=1;fillColor=#E3F1EF;strokeColor=#0D6158;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="420" y="812" width="16" height="16" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
